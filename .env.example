# moonbridge + hub — ЕДИНЫЙ конфиг. Скопируй в .env.
# Обязательны только эти две строки. Всё остальное создаётся само.

TELEGRAM_BOT_TOKEN=123456789:ABCDEF-your-telegram-bot-token
ADMIN_CHAT_IDS=111111111        # твой Telegram chat_id (через запятую можно несколько)

# ── Необязательно (есть дефолты) ──────────────────────────────────
# MOONBRIDGE_DB=data/moonbridge.db   # файл SQLite (создаётся сам)
# MOONBRIDGE_LOG_DIR=logs            # каталог логов
# LOG_LEVEL=INFO
